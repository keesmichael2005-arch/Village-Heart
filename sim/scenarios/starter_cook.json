{
  "schema": 1,
  "name": "starter_cook",
  "description": "M13: starter plus a 9x9 wheat field, 32 coal in Storage and a Cook hired on day 1 at the Kitchen; the average nutrition per eaten item must beat the stored starter run (sim/baselines/starter.json, days 3..10). Wheat is not food, so without the cook the extra field changes nothing eaten. Base description: M11: a small working village on the seed-1 plains village. Prebuilt House x2, Storage (2 days of bread), Farmhouse + 9x9 mature carrot field, Lumber Camp (diamond axe, oak grove), Kitchen; a farmer and a lumberjack hired on day 1 (teleported to their door; a replacement is hired when one dies). Normal difficulty, mobs on. M12: the owner puts 32 emeralds in the treasury at setup (villageheart treasury add 32): each hire is charged 1 at once (2 on day 1) and the dawns of days 2..10 cost 2 each, 20 in all, so nobody strikes; wages leave the treasury every day (the assertions say so).",
  "default_days": 10,
  "baseline": "../baselines/starter.json",
  "actions": [
    { "action": "claim" },
    { "action": "command", "command": "villageheart treasury add 32" },
    { "action": "site", "size": [44, 32], "min_distance": 24, "max_distance": 72, "max_deviation": 5, "odd_percent": 4 },
    { "action": "prefab", "building": "house",       "at": [2, 2],   "size": [5, 4], "door": "south", "contents": ["bed", "bed", "light"] },
    { "action": "prefab", "building": "house",       "at": [10, 2],  "size": [5, 4], "door": "south", "contents": ["bed", "bed", "light"] },
    { "action": "prefab", "building": "storage",     "at": [18, 2],  "size": [4, 3], "door": "south", "contents": ["chest", "chest", "light"],
      "chest_items": { "minecraft:bread": 40, "minecraft:coal": 32 } },
    { "action": "prefab", "building": "kitchen",     "at": [25, 2],  "size": [4, 3], "door": "south", "contents": ["smoker", "chest", "crafting_table", "light"] },
    { "action": "prefab", "building": "farmhouse",   "at": [2, 14],  "size": [4, 3], "door": "north", "contents": ["composter", "chest", "light"] },
    { "action": "field", "at": [10, 14], "size": 9, "crop": "carrots", "age": 7 },
    { "action": "field", "at": [10, 23], "size": 9, "crop": "wheat", "age": 7 },
    { "action": "prefab", "building": "lumber_camp", "at": [24, 14], "size": [4, 3], "door": "north", "contents": ["chopping_block", "chest", "light"],
      "chest_items": { "minecraft:diamond_axe": 1, "minecraft:oak_sapling": 8 } },
    { "action": "grove", "area": [22, 21, 20, 10], "trees": 8, "spacing": 5, "seed": 11 },
    { "action": "hire", "day": 1, "tick": 200, "job": "farmer", "building": "farmhouse", "replace": true },
    { "action": "hire", "day": 1, "tick": 200, "job": "lumberjack", "building": "lumber_camp", "replace": true },
    { "action": "hire", "day": 1, "tick": 200, "job": "cook", "building": "kitchen", "replace": true }
  ],
  "assertions": [
    "claimed == 1 on every day",
    "employed == 3 on day 1",
    "food.dinners == 1 on every day",
    "sum(deaths.cause.minecraft:starve) == 0 from day 1",
    "sum(food.fed) >= 0.9 * sum(food.diners) from day 3",
    "max(food.max_hungry_days) < 3 from day 3",
    "stockpile.tag.minecraft:logs > stockpile.tag.minecraft:logs@prev on every day",
    "max(wages.strikers) == 0 from day 1",
    "sum(wages.runs) >= 8 from day 1",
    "treasury <= treasury@prev - 2 from day 3",
    "min(work.farmer.harvested) > 0 from day 3",
    "sum(work.workers.not_ticking) == 0 from day 1",
    "sum(work.cook.items) >= 40 from day 2",
    "sum(food.eaten_nutrition) / sum(food.eaten_items) > sum(food.eaten_nutrition@base) / sum(food.eaten_items@base) from day 3",
    "village_ms.mean < 1 on every day"
  ]
}
