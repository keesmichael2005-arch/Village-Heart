  "assertions": [
    "claimed == 1 on every day",
    "employed == 9 on day 1",
    "population >= 12 on day 1",
    "golems.in_claim <= 1 on every day",
    "golems.in_claim >= 1 on day 2",
    "raid.guards_at_start == 4 on day 3",
